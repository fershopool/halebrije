# No publicar datos sin confirmar con Halebrije.
VITE_WHATSAPP_NUMBER=
VITE_WHATSAPP_DEFAULT_MESSAGE=Hola, quiero conocer los sabores disponibles en Halebrije.
# Endpoint HTTPS opcional para cotizaciones. Vacío = demostración local, sin envío.
VITE_EVENTS_ENDPOINT=
# URL pública definitiva; vacía = SEO de propuesta, sin sitemap inventado.
VITE_SITE_URL=
# Mantener true durante la propuesta. false habilita SEO con dominio configurado.
VITE_IS_PROPOSAL=true

# Subcarpeta pública (GitHub Pages); / para dominio raíz.
VITE_BASE_PATH=/
